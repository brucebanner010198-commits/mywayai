<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mywayai.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>{{BIN_PATH}} {{DASHBOARD_ARGS}}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{HOME}}/.mywayai/logs/dashboard.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/.mywayai/logs/dashboard.launchd.err.log</string>
</dict>
</plist>
